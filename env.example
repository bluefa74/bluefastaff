# ─────────────────────────────────────────────────────────────────────────────
#  HorizonPvP — Bot Discord + Staff Dashboard
#  Copie ce fichier en .env et remplis chaque valeur
# ─────────────────────────────────────────────────────────────────────────────

# ── BOT DISCORD ───────────────────────────────────────────────────────────────
# Token de ton bot → https://discord.com/developers/applications → ton app → Bot → Token
DISCORD_TOKEN=

# Client ID de ton app Discord → Onglet "OAuth2" ou "General Information"
CLIENT_ID=

# ── SERVEUR DISCORD ───────────────────────────────────────────────────────────
# ID de ton serveur Discord (clic droit sur le serveur → Copier l'identifiant)
GUILD_ID=

# ID du salon de logs (clic droit sur le salon → Copier l'identifiant)
LOGS_CHANNEL_ID=

# ── RÔLES ────────────────────────────────────────────────────────────────────
# ID du rôle Staff (clic droit sur le rôle → Copier l'identifiant)
# Note : déjà hardcodé dans CONFIG mais tu peux le mettre ici aussi
# STAFF_ROLE_ID=1505217107112104056

# ID du rôle qui a accès aux commandes FiveM IG
FIVEM_ROLE_ID=

# ── FIVEM ─────────────────────────────────────────────────────────────────────
# IP de ton serveur FiveM (sans http://)
FIVEM_IP=

# Port du bridge FiveM (défaut : 30062)
FIVEM_PORT=30062

# Clé API de ton bridge FiveM (définie dans ta resource discord_bridge)
FIVEM_API_KEY=

# ── IA GROQ ───────────────────────────────────────────────────────────────────
# Clé API Groq pour Braksoo → https://console.groq.com/keys
GROQ_API_KEY=

# ── STAFF DASHBOARD ───────────────────────────────────────────────────────────
# URL de ton dashboard Railway (ex: https://xxx.up.railway.app)
# Laisser vide si pas encore déployé
DASHBOARD_URL=

# Clé secrète partagée entre le bot et le dashboard
# Génère une clé aléatoire longue, ex: openssl rand -hex 32
# DOIT être identique à INTERNAL_API_KEY dans le .env du dashboard
INTERNAL_API_KEY=
